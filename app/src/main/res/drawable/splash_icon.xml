<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the launcher artwork (ic_launcher_foreground.xml, keep the two in sync) assembling
     itself. The frame draws in, the mountain rises, the sun and badge pop in, then the slash strikes out the pin.
     The vector starts in its "before" state so nothing flashes ahead of the animation. ~950 ms in total. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <group android:pivotX="54" android:pivotY="54" android:scaleX="0.78" android:scaleY="0.78">

                <path
                    android:name="frame"
                    android:fillColor="#00000000"
                    android:strokeColor="#3D5A80"
                    android:strokeWidth="4"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0"
                    android:pathData="M51,68 H33 A6,6 0 0,1 27,62 V36 A6,6 0 0,1 33,30 H62 A6,6 0 0,1 68,36 V51" />

                <group android:name="mountains" android:pivotX="44.75" android:pivotY="62.5" android:scaleY="0">
                    <path
                        android:fillColor="#5E9C8A"
                        android:pathData="M32.5,62.5 L43,49.5 L49.5,56.5 L53.5,52.5 L57,57 L50.5,62.5 Z" />
                </group>

                <group android:name="sun" android:pivotX="59" android:pivotY="40" android:scaleX="0" android:scaleY="0">
                    <path
                        android:fillColor="#F2A541"
                        android:pathData="M55.5,40 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
                </group>

                <group android:name="badge" android:pivotX="68" android:pivotY="68" android:scaleX="0" android:scaleY="0">
                    <path
                        android:fillColor="#D9664A"
                        android:pathData="M55,68 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />

                    <group android:name="pin" android:translateY="-4">
                        <path
                            android:fillColor="#FFF8F2"
                            android:fillType="evenOdd"
                            android:pathData="M68,59 a5.8,5.8 0 0,0 -5.8,5.8 c0,4 5.8,10.4 5.8,10.4 s5.8,-6.4 5.8,-10.4 a5.8,5.8 0 0,0 -5.8,-5.8 Z M68,67 a2.2,2.2 0 1,1 0,-4.4 a2.2,2.2 0 1,1 0,4.4 Z" />
                    </group>

                    <path
                        android:name="slash_cut"
                        android:fillColor="#00000000"
                        android:strokeColor="#D9664A"
                        android:strokeWidth="3.6"
                        android:strokeLineCap="round"
                        android:trimPathEnd="0"
                        android:pathData="M62.2,59.6 L73.8,74.4" />
                    <path
                        android:name="slash"
                        android:fillColor="#00000000"
                        android:strokeColor="#FFF8F2"
                        android:strokeWidth="1.9"
                        android:strokeLineCap="round"
                        android:trimPathEnd="0"
                        android:pathData="M62.2,59.6 L73.8,74.4" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="frame">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="mountains">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="200"
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="sun">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="300"
                    android:duration="300"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="300"
                    android:duration="300"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="badge">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="400"
                    android:duration="350"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="400"
                    android:duration="350"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="pin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:valueFrom="-4"
                android:valueTo="0"
                android:startOffset="450"
                android:duration="300"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>

    <target android:name="slash_cut">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="700"
                android:duration="250"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="slash">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="700"
                android:duration="250"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
